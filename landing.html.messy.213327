<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Earnify | منصة التسويق بالعمولة</title><meta name="description" content="Earnify منصة تسويق بالعمولة: اربح عمولات عالية من تسويق المنتجات."><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/premium.css"><style>
*{margin:0;padding:0;box-sizing:border-box}
.wrap{max-width:1150px;margin:0 auto;padding:0 20px}
section{padding:64px 0}
.h2{font-size:2rem;font-weight:800;text-align:center;margin-bottom:8px}
.sub{color:var(--mut);text-align:center;margin-bottom:36px}
.navbar{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;position:sticky;top:0;z-index:90}
.logo{font-size:1.4rem;font-weight:800;color:var(--p)}
.navlinks{display:flex;gap:20px}
.navlinks a{color:var(--tx);text-decoration:none;font-weight:600}
.hero{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;padding:80px 0 40px}
.hero h1{font-size:2.6rem;line-height:1.2;margin-bottom:16px}
.hero h1 span{color:var(--p2)}
.hero p{color:var(--mut);margin-bottom:22px;font-size:1.05rem}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.trust{display:flex;gap:16px;margin-top:22px;flex-wrap:wrap}
.trust div{font-size:.85rem;color:var(--mut)}
.mock{position:relative}
.mock .card{padding:20px}
.float{position:absolute;background:var(--card);border-radius:14px;padding:10px 14px;box-shadow:var(--sh2);animation:fl 4s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(-12px)}}
.bars{display:flex;gap:8px;align-items:flex-end;height:120px;margin-top:14px}
.bars i{flex:1;background:linear-gradient(180deg,var(--p2),var(--p));border-radius:6px 6px 0 0}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px}
.stat{text-align:center;padding:26px 14px}
.stat b{font-size:2rem;color:var(--p2)}
.stat span{color:var(--mut);font-size:.9rem}
.cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px}
.cat{padding:24px 12px;text-align:center}
.cat i{font-size:2rem;display:block;margin-bottom:8px;font-style:normal}
@media(max-width:820px){.hero{grid-template-columns:1fr}.hero h1{font-size:2rem}.navlinks{display:none}}
</style></head><body>
<div id="loadScreen"><div class="spin"></div></div>
<header class="navbar glass"><div class="logo">💰 Earnify</div><nav class="navlinks"><a href="#feat">المنتجات</a><a href="#how">كيف تعمل</a><a href="#dash">لوحة التحكم</a><a href="#calc">حاسبة الأرباح</a><a href="#faq">الأسئلة</a></nav><div style="display:flex;gap:10px;align-items:center"><button class="btn glass" onclick="toggleTheme()">🌓</button><a href="/" class="btn grad" style="color:#fff;text-decoration:none">ابدأ الآن</a></div></header>
<section class="hero wrap"><div class="reveal"><h1>اربح <span>عمولات عالية</span> من تسويق أفضل المنتجات</h1><p>انضم لآلاف المسوقين في Earnify، سوّق المنتجات، واكسب عمولة على كل عملية بيع. بدون رأس مال.</p><div class="cta"><a href="/" class="btn grad" style="color:#fff;text-decoration:none">🚀 ابدأ التسويق مجاناً</a><a href="#how" class="btn glass" style="text-decoration:none;color:var(--tx)">كيف تعمل؟</a></div><div class="trust"><div>⭐ 4.9 تقييم</div><div>✅ دفع مضمون</div><div>🔒 آمن 100%</div><div>📦 شحن سريع</div></div></div>
<div class="mock reveal"><div class="card"><b>أرباحك هذا الشهر</b><div class="bars"><i style="height:40%"></i><i style="height:65%"></i><i style="height:50%"></i><i style="height:80%"></i><i style="height:70%"></i><i style="height:95%"></i></div></div><div class="float" style="top:-16px;inset-inline-end:-10px">💵 +2,450 ج.م</div><div class="float" style="bottom:-14px;inset-inline-start:-8px;animation-delay:1.2s">📈 320 طلب</div></div></section>
<section class="wrap"><div class="grid3"><div class="stat card reveal"><b data-count="12500">0</b><span>مسوق نشط</span></div><div class="stat card reveal"><b data-count="850">0</b><span>منتج</span></div><div class="stat card reveal"><b data-count="3200000">0</b><span>ج.م عمولات مدفوعة</span></div><div class="stat card reveal"><b data-count="98">0</b><span>% رضا العملاء</span></div></div></section>
<section class="wrap" id="cats"><h2 class="h2">تسوّق حسب التصنيف</h2><p class="sub">أشهر التصنيفات الأعلى مبيعاً</p><div class="cats"><div class="cat card reveal"><i>📱</i>إلكترونيات</div><div class="cat card reveal"><i>👗</i>أزياء</div><div class="cat card reveal"><i>💄</i>جمال</div><div class="cat card reveal"><i>🏠</i>منزل</div><div class="cat card reveal"><i>👶</i>أطفال</div><div class="cat card reveal"><i>⚽</i>رياضة</div></div></section>
<style>
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.pcard{overflow:hidden;display:flex;flex-direction:column}
.pcard img{width:100%;height:170px;object-fit:cover}
.pbody{padding:14px;display:flex;flex-direction:column;gap:8px;flex:1}
.pname{font-weight:700;font-size:.95rem}
.prices{display:flex;gap:8px;align-items:center}
.now{color:var(--p2);font-weight:800}
.old{color:var(--mut);text-decoration:line-through;font-size:.85rem}
.badge{font-size:.7rem;padding:3px 8px;border-radius:20px;background:#d1fae5;color:#047857;font-weight:700}
.comm{font-size:.78rem;color:var(--gold);font-weight:700}
.rate{color:#f59e0b;font-size:.8rem}
.pact{display:flex;gap:6px;margin-top:auto}
.pact button,.pact a{flex:1;border:none;border-radius:10px;padding:8px;font-size:.75rem;cursor:pointer;font-weight:700}
.trend{display:flex;gap:14px;overflow-x:auto;padding:10px 4px;scroll-snap-type:x mandatory}
.trend .pcard{min-width:220px;scroll-snap-align:start}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
.step{text-align:center;padding:28px 16px}
.step b{width:52px;height:52px;border-radius:50%;background:var(--p);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:12px}
.feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.fcard{padding:26px}
.fcard i{font-size:2rem;font-style:normal;display:block;margin-bottom:10px}
</style>
<section class="wrap" id="feat"><h2 class="h2">منتجات مميزة</h2><p class="sub">أعلى المنتجات عمولةً — سوّقها الآن</p><input id="pSearch" class="glass" style="width:100%;padding:12px 16px;border-radius:12px;border:1px solid var(--mut);margin-bottom:18px" placeholder="🔍 ابحث عن منتج..."><div class="pgrid" id="featGrid"><div class="skeleton" style="height:280px"></div><div class="skeleton" style="height:280px"></div><div class="skeleton" style="height:280px"></div><div class="skeleton" style="height:280px"></div></div></section>
<section class="wrap"><h2 class="h2">🔥 الأكثر رواجاً</h2><p class="sub">منتجات يتهافت عليها المشترين</p><div class="trend" id="trendRow"></div></section>
<section class="wrap" id="how"><h2 class="h2">كيف تعمل Earnify؟</h2><p class="sub">أربع خطوات بسيطة وتبدأ الكسب</p><div class="steps"><div class="step card reveal"><b>1</b><h3>سجّل مجاناً</h3><p style="color:var(--mut);font-size:.85rem">أنشئ حسابك في دقيقة</p></div><div class="step card reveal"><b>2</b><h3>اختر منتجاً</h3><p style="color:var(--mut);font-size:.85rem">تصفح المنتجات واختر ما يناسبك</p></div><div class="step card reveal"><b>3</b><h3>انسخ الرابط</h3><p style="color:var(--mut);font-size:.85rem">شارك رابطك الخاص على جمهورك</p></div><div class="step card reveal"><b>4</b><h3>اكسب العمولة</h3><p style="color:var(--mut);font-size:.85rem">عمولة على كل عملية بيع ناجحة</p></div></div></section>
<section class="wrap"><h2 class="h2">لماذا Earnify؟</h2><p class="sub">مميزات تجعلنا الخيار الأول للمسوقين</p><div class="feat"><div class="fcard card reveal"><i>💸</i><h3>عمولات عالية</h3><p style="color:var(--mut);font-size:.85rem">أعلى نسب عمولة في السوق</p></div><div class="fcard card reveal"><i>⚡</i><h3>سحب أرباح فوري</h3><p style="color:var(--mut);font-size:.85rem">اسحب أرباحك متى شئت</p></div><div class="fcard card reveal"><i>📊</i><h3>لوحة تحكم ذكية</h3><p style="color:var(--mut);font-size:.85rem">تابع نقراتك ومبيعاتك لحظياً</p></div><div class="fcard card reveal"><i>🎧</i><h3>دعم متواصل</h3><p style="color:var(--mut);font-size:.85rem">فريق دعم جاهز لمساعدتك</p></div></div></section>
<style>
.dash{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:20px}
.kpi{padding:20px}
.kpi small{color:var(--mut)}
.kpi b{font-size:1.6rem;display:block;color:var(--p2)}
.panel{padding:20px}
.earn{display:flex;gap:8px;align-items:flex-end;height:140px;margin-top:12px}
.earn i{flex:1;background:linear-gradient(180deg,var(--gold),#f5d78e);border-radius:6px 6px 0 0}
.orders td{padding:8px;font-size:.85rem;border-bottom:1px solid rgba(100,116,139,.15)}
.calc{max-width:520px;margin:0 auto;padding:28px}
.calc label{display:block;margin:12px 0 4px;font-weight:600;font-size:.9rem}
.calc input{width:100%;padding:11px;border-radius:10px;border:1px solid var(--mut)}
.calc .res{margin-top:18px;padding:16px;border-radius:12px;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;text-align:center;font-size:1.3rem;font-weight:800}
.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.tcard{padding:22px}
.tcard .rate{margin-bottom:8px}
.faq{max-width:700px;margin:0 auto}
.fitem{margin-bottom:10px;overflow:hidden}
.faq-q{width:100%;text-align:right;padding:16px;background:var(--card);border:none;font-weight:700;cursor:pointer;border-radius:12px;font-size:.95rem;color:var(--tx)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s;background:var(--card)}
.fitem.open .faq-a{padding:0 16px 14px}
.faq-a p{color:var(--mut);font-size:.9rem}
.bigcta{text-align:center;padding:64px 20px;border-radius:24px;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;margin:20px}
footer{background:#0b1220;color:#cbd5e1;padding:48px 0 20px;margin-top:40px}
.fcols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px}
footer h4{color:#fff;margin-bottom:12px}
footer a{color:#94a3b8;text-decoration:none;display:block;margin:6px 0;font-size:.9rem}
.news{display:flex;gap:8px;margin-top:10px}
.news input{flex:1;padding:10px;border-radius:10px;border:none}
.copy{text-align:center;margin-top:26px;color:#64748b;font-size:.85rem;border-top:1px solid #1e293b;padding-top:16px}
</style>
<section class="wrap" id="dash"><h2 class="h2">لوحة تحكم احترافية</h2><p class="sub">تابع أداءك لحظياً</p><div class="dash"><div class="kpi card reveal"><small>الإيرادات</small><b>48,200 ج.م</b></div><div class="kpi card reveal"><small>الطلبات</small><b>1,240</b></div><div class="kpi card reveal"><small>النقرات</small><b>25,800</b></div><div class="kpi card reveal"><small>معدل التحويل</small><b>4.8%</b></div></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px"><div class="panel card reveal"><b>الأرباح الشهرية</b><div class="earn"><i style="height:35%"></i><i style="height:55%"></i><i style="height:45%"></i><i style="height:75%"></i><i style="height:60%"></i><i style="height:90%"></i></div></div><div class="panel card reveal"><b>أحدث الطلبات</b><table class="orders" style="width:100%;margin-top:10px"><tr><td>طلب #1042</td><td style="color:var(--p2)">+120 ج.م</td></tr><tr><td>طلب #1041</td><td style="color:var(--p2)">+85 ج.م</td></tr><tr><td>طلب #1040</td><td style="color:var(--p2)">+210 ج.م</td></tr></table></div></div></section>
<section class="wrap" id="calc"><h2 class="h2">حاسبة الأرباح</h2><p class="sub">احسب كم يمكنك أن تربح</p><div class="calc card"><label>عدد النقرات المتوقعة شهرياً</label><input type="number" id="cClicks" value="1000"><label>معدل التحويل %</label><input type="number" id="cConv" value="3"><label>متوسط العمولة لكل عملية (ج.م)</label><input type="number" id="cComm" value="60"><button class="btn grad" style="width:100%;margin-top:16px;color:#fff" onclick="calcEarnings()">احسب أرباحي</button><div class="res" id="cRes">0 ج.م / شهر</div></div></section>
<section class="wrap"><h2 class="h2">ماذا يقول المسوقون؟</h2><p class="sub">آراء حقيقية من مسوقينا</p><div class="tgrid"><div class="tcard card reveal"><div class="rate">⭐⭐⭐⭐⭐</div><p>"حققت أول 5000 جنيه في شهري الأول. المنصة سهلة جداً."</p><b>— أحمد م.</b></div><div class="tcard card reveal"><div class="rate">⭐⭐⭐⭐⭐</div><p>"أفضل منصة عمولة جربتها، والسحب فوري بدون مشاكل."</p><b>— سارة ع.</b></div><div class="tcard card reveal"><div class="rate">⭐⭐⭐⭐⭐</div><p>"الدعم الفني ممتاز ولوحة التحكم واضحة جداً."</p><b>— محمد ر.</b></div></div></section>
<section class="wrap" id="faq"><h2 class="h2">الأسئلة الشائعة</h2><div class="faq"><div class="fitem card"><button class="faq-q">هل الاشتراك مجاني؟</button><div class="faq-a"><p>نعم، التسجيل مجاني تماماً ولا يحتاج رأس مال.</p></div></div><div class="fitem card"><button class="faq-q">كيف أستلم عمولاتي؟</button><div class="faq-a"><p>يمكنك سحب أرباحك عبر فودافون كاش أو إنستاباي أو تحويل بنكي.</p></div></div><div class="fitem card"><button class="faq-q">كم نسبة العمولة؟</button><div class="faq-a"><p>تختلف حسب المنتج وتظهر لكل منتج، وتصل حتى 30%.</p></div></div><div class="fitem card"><button class="faq-q">هل أحتاج خبرة؟</button><div class="faq-a"><p>لا، نوفر لك روابط جاهزة وأدوات تسهّل التسويق للمبتدئين.</p></div></div></div></section>
<section class="wrap"><div class="bigcta reveal"><h2 style="font-size:1.8rem;margin-bottom:10px">جاهز تبدأ رحلة الكسب؟</h2><p style="margin-bottom:20px;opacity:.9">انضم الآن وابدأ التسويق خلال دقائق</p><a href="/" class="btn" style="background:#fff;color:var(--p);text-decoration:none">🚀 سجّل مجاناً الآن</a></div></section>
<footer><div class="wrap fcols"><div><h4>💰 Earnify</h4><p style="font-size:.9rem;color:#94a3b8">منصة التسويق بالعمولة الأولى في مصر.</p><div class="news"><input placeholder="بريدك الإلكتروني"><button class="btn grad" style="color:#fff" onclick="toast('تم الاشتراك بنجاح')">اشترك</button></div></div><div><h4>روابط</h4><a href="#feat">المنتجات</a><a href="#how">كيف تعمل</a><a href="#calc">حاسبة الأرباح</a></div><div><h4>الدعم</h4><a href="#faq">الأسئلة الشائعة</a><a href="/">اتصل بنا</a><a href="#">سياسة الخصوصية</a><a href="#">الشروط والأحكام</a></div><div><h4>تابعنا</h4><a href="#">📘 فيسبوك</a><a href="#">📸 إنستجرام</a><a href="#">🎵 تيك توك</a></div></div><div class="copy wrap">© 2026 Earnify — جميع الحقوق محفوظة</div></footer>
<button id="toTop">↑</button><a id="waFloat" href="https://wa.me/20" target="_blank">🟢</a>
<script>
var PRODS=[];
function stars(){return "⭐⭐⭐⭐⭐";}
function card(p){var price=Math.round(p.price||0);var old=Math.round(price*1.3);var comm=Math.max(10,Math.round(price*0.12));var stock=(p.stock>0)?'<span class="badge">متوفر</span>':'<span class="badge" style="background:#fee2e2;color:#b91c1c">نفد</span>';
return '<div class="pcard card" data-name="'+(p.name||'').toLowerCase()+'"><img src="'+(p.image||'')+'" loading="lazy" alt="'+(p.name||'')+'"><div class="pbody"><div class="pname">'+(p.name||'منتج')+'</div><div class="prices"><span class="now">'+price.toLocaleString('ar-EG')+' ج.م</span><span class="old">'+old.toLocaleString('ar-EG')+'</span></div><div class="comm">💰 عمولتك: '+comm+' ج.م</div><div style="display:flex;gap:6px;align-items:center"><span class="rate">'+stars()+'</span>'+stock+'<span class="badge">🚚 شحن مجاني</span></div><div class="pact"><button class="grad" style="color:#fff" onclick="copyLink('+p.id+')">نسخ الرابط</button><button class="glass" onclick="shareP('+p.id+')">مشاركة</button></div></div></div>';}
function copyLink(id){navigator.clipboard&&navigator.clipboard.writeText(location.origin+"/?p="+id);toast("تم نسخ رابط المنتج ✅");}
function shareP(id){if(navigator.share){navigator.share({title:"Earnify",url:location.origin+"/?p="+id});}else{copyLink(id);}}
function calcEarnings(){var c=+document.getElementById("cClicks").value||0;var v=+document.getElementById("cConv").value||0;var m=+document.getElementById("cComm").value||0;var e=Math.round(c*(v/100)*m);document.getElementById("cRes").textContent=e.toLocaleString("ar-EG")+" ج.م / شهر";toast("أرباحك المتوقعة: "+e+" ج.م");}
document.getElementById("pSearch").addEventListener("input",function(e){var q=e.target.value.toLowerCase();document.querySelectorAll("#featGrid .pcard").forEach(function(el){el.style.display=el.dataset.name.indexOf(q)>-1?"":"none";});});
fetch("/api/products").then(function(r){return r.json();}).then(function(d){PRODS=d||[];var fg=document.getElementById("featGrid");fg.innerHTML=PRODS.slice(0,12).map(card).join("");var tr=document.getElementById("trendRow");tr.innerHTML=PRODS.slice(12,24).map(card).join("");}).catch(function(){document.getElementById("featGrid").innerHTML="<p>تعذر تحميل المنتجات</p>";});
// trending auto-scroll
setInterval(function(){var t=document.getElementById("trendRow");if(t){t.scrollBy({left:240,behavior:"smooth"});if(t.scrollLeft+t.clientWidth>=t.scrollWidth-10)t.scrollTo({left:0,behavior:"smooth"});}},3500);
</script><script>setTimeout(function(){var l=document.getElementById("loadScreen");if(l)l.classList.add("hide")},1800);</script></body></html>