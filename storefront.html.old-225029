<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Earnify | المتجر</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lalezar&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0B1F17;
  --forest:#0E5B3A;
  --forest-d:#0A4229;
  --leaf:#1F9D55;
  --mint:#EEF7F1;
  --paper:#FFFFFF;
  --line:#D8E8DE;
  --muted:#5B6F64;
  --warn:#B8860B;
  --danger:#B3261E;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{font-family:Cairo,system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.55;padding-bottom:74px}
img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none;background:none}
input,select,textarea{font-family:inherit}
h1,h2,h3{font-family:Lalezar,Cairo,sans-serif;font-weight:400}

/* ---- stamp motif: signature element ---- */
.stamp{
  display:inline-flex;align-items:center;gap:6px;
  border:1.6px dashed var(--forest);color:var(--forest-d);
  border-radius:50px;padding:5px 12px;font-size:.72rem;font-weight:800;
  transform:rotate(-3deg);white-space:nowrap;background:var(--mint)
}

/* ---- header ---- */
header{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid var(--line)}
.header-top{display:flex;align-items:center;gap:10px;padding:12px 16px}
.logo{font-family:Lalezar,sans-serif;font-size:1.6rem;color:var(--forest);flex-shrink:0}
.logo span{color:var(--ink)}
.search{flex:1;position:relative}
.search input{width:100%;padding:11px 40px 11px 14px;border:1.5px solid var(--line);border-radius:50px;font-size:.88rem;background:var(--mint);outline:none;color:var(--ink)}
.search input:focus{border-color:var(--leaf)}
.search::before{content:'🔍';position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:.85rem;opacity:.6}
.cart-btn{position:relative;flex-shrink:0;width:42px;height:42px;border-radius:50%;background:var(--forest);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.15rem}
.cart-btn i{position:absolute;top:-4px;left:-4px;background:var(--ink);color:#fff;font-style:normal;font-size:.62rem;font-weight:800;border-radius:50px;min-width:17px;height:17px;display:flex;align-items:center;justify-content:center;border:2px solid var(--paper)}
.cats{display:flex;gap:8px;overflow-x:auto;padding:0 16px 12px;scrollbar-width:none}
.cats::-webkit-scrollbar{display:none}
.cc{flex:0 0 auto;padding:7px 15px;border-radius:50px;border:1.5px solid var(--line);background:var(--paper);font-weight:700;font-size:.78rem;color:var(--muted)}
.cc.on{background:var(--forest);border-color:var(--forest);color:#fff}

/* ---- hero ---- */
.hero{background:var(--forest);color:#fff;padding:26px 18px 30px;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 85% 20%,rgba(255,255,255,.08),transparent 55%)}
.hero-in{position:relative;max-width:640px;margin:0 auto}
.hero h1{font-size:1.7rem;line-height:1.4;margin-bottom:8px}
.hero p{font-size:.85rem;opacity:.85;margin-bottom:14px}
.hero .stamp{border-color:rgba(255,255,255,.6);background:rgba(255,255,255,.08);color:#fff}

/* ---- product grid ---- */
main{max-width:640px;margin:0 auto;padding:16px}
.sec-t{font-size:1.15rem;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.sec-t small{font-family:Cairo;font-size:.72rem;color:var(--muted);font-weight:700}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:480px){.grid{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--paper);border:1px solid var(--line);border-radius:16px;overflow:hidden;cursor:pointer}
.card .imgwrap{position:relative;aspect-ratio:1;background:var(--mint)}
.card img{width:100%;height:100%;object-fit:cover}
.card .cod{position:absolute;bottom:6px;right:6px;background:rgba(255,255,255,.92);color:var(--forest-d);font-size:.6rem;font-weight:800;padding:3px 7px;border-radius:6px;border:1px solid var(--line)}
.card .b{padding:10px}
.card .t{font-size:.82rem;font-weight:700;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.3em;margin-bottom:5px}
.card .pr{font-size:.98rem;font-weight:800;color:var(--forest-d)}
.card .stock{font-size:.68rem;margin-top:4px;font-weight:700}
.stock-ok{color:var(--leaf)}.stock-low{color:var(--warn)}.stock-out{color:var(--danger)}
.empty{grid-column:1/-1;text-align:center;padding:40px 10px;color:var(--muted)}

/* ---- floating whatsapp ---- */
#waFloat{position:fixed;bottom:88px;left:16px;z-index:60;width:52px;height:52px;border-radius:50%;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 8px 20px rgba(0,0,0,.2);text-decoration:none}

/* ---- bottom nav ---- */
.mnav{position:fixed;bottom:0;left:0;right:0;background:var(--paper);border-top:1px solid var(--line);display:flex;z-index:55;padding-bottom:env(safe-area-inset-bottom)}
.mnav button{flex:1;padding:9px 4px;font-size:.66rem;font-weight:700;color:var(--muted)}
.mnav button.on{color:var(--forest-d)}
.mnav .ic{display:block;font-size:1.15rem;margin-bottom:2px}

/* ---- footer ---- */
footer{background:var(--mint);border-top:1px solid var(--line);padding:26px 16px;text-align:center;color:var(--muted);font-size:.78rem;margin-top:10px}
footer .logo{margin-bottom:8px;justify-content:center;display:flex}

/* ---- modals / sheets ---- */
.modal{position:fixed;inset:0;background:rgba(11,31,23,.5);z-index:200;display:none;align-items:flex-end;justify-content:center}
.modal.on{display:flex}
.sheet{background:var(--paper);border-radius:22px 22px 0 0;width:100%;max-width:560px;max-height:88vh;overflow:auto;padding:18px}
.sheet-x{position:sticky;top:0;float:left;width:34px;height:34px;border-radius:50%;background:var(--mint);color:var(--ink);font-size:1rem;display:flex;align-items:center;justify-content:center;margin-bottom:6px}
.pm-img{border-radius:14px;height:210px;object-fit:cover;width:100%;background:var(--mint);margin-bottom:12px}
.pm-name{font-size:1.05rem;font-weight:800;margin-bottom:4px}
.pm-price{color:var(--forest-d);font-weight:900;font-size:1.2rem;margin-bottom:10px}
.pm-desc{font-size:.83rem;color:var(--muted);margin-bottom:14px}
.qtyrow{display:flex;align-items:center;gap:14px;margin:14px 0}
.qtyrow button{width:38px;height:38px;border-radius:10px;background:var(--mint);font-size:1.2rem;font-weight:800;color:var(--forest-d)}
.qtyrow b{font-size:1.05rem;min-width:24px;text-align:center}
.addbtn{width:100%;background:var(--forest);color:#fff;border-radius:14px;padding:14px;font-weight:800;font-size:.95rem}
.addbtn:disabled{opacity:.5}

.ci{display:flex;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}
.ci img{width:54px;height:54px;border-radius:10px;object-fit:cover;background:var(--mint)}
.ci .n{flex:1;font-size:.8rem;font-weight:700}
.ci .n small{color:var(--muted);font-weight:600}
.ci .p{color:var(--forest-d);font-weight:800;font-size:.85rem}
.ci .rm{background:#fdecea;color:var(--danger);border-radius:8px;padding:5px 9px;font-size:.68rem;font-weight:700;margin-right:4px}
.cart-empty{text-align:center;color:var(--muted);padding:34px 10px}

label{display:block;font-size:.78rem;font-weight:700;margin:12px 0 5px;color:var(--muted)}
.field{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:11px 12px;font-size:.88rem;background:var(--paper);color:var(--ink);outline:none}
.field:focus{border-color:var(--leaf)}
.tot{display:flex;justify-content:space-between;align-items:center;font-weight:800;margin:14px 0;padding-top:12px;border-top:1px dashed var(--line)}
.tot b{color:var(--forest-d);font-size:1.15rem}
.msg{margin-top:10px;font-size:.84rem;font-weight:700;text-align:center}
.msg.ok{color:var(--leaf)}.msg.err{color:var(--danger)}

.skel-i{background:var(--paper);border-radius:16px;overflow:hidden;border:1px solid var(--line)}
.skel-img{height:150px;background:linear-gradient(90deg,var(--mint) 25%,#e2efe6 50%,var(--mint) 75%);background-size:200% 100%;animation:sh 1.2s infinite}
.skel-t{height:11px;background:var(--mint);margin:10px;border-radius:6px}
.skel-p{height:13px;background:var(--mint);margin:10px;width:50%;border-radius:6px}
@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}
</style>
</head>
<body>

<header>
  <div class="header-top">
    <div class="logo">Earn<span>ify</span></div>
    <div class="search"><input id="q" placeholder="ابحث عن منتج..." oninput="doSearch(this.value)"></div>
    <button class="cart-btn" onclick="openCart()">🛒<i id="cc">0</i></button>
  </div>
  <div class="cats" id="catRow"></div>
</header>

<div class="hero">
  <div class="hero-in">
    <span class="stamp">✓ الدفع عند الاستلام</span>
    <h1 style="margin-top:12px">تسوّق واستلم لحد باب البيت</h1>
    <p>منتجات مختارة بعناية — تدفع لما تستلم طلبك من غير أي مقدم</p>
  </div>
</div>

<main>
  <div class="sec-t"><span id="prodTitle">كل المنتجات</span></div>
  <div class="grid" id="mainGrid">
    <div class="skel-i"><div class="skel-img"></div><div class="skel-t"></div><div class="skel-p"></div></div>
    <div class="skel-i"><div class="skel-img"></div><div class="skel-t"></div><div class="skel-p"></div></div>
    <div class="skel-i"><div class="skel-img"></div><div class="skel-t"></div><div class="skel-p"></div></div>
    <div class="skel-i"><div class="skel-img"></div><div class="skel-t"></div><div class="skel-p"></div></div>
  </div>
</main>

<a id="waFloat" target="_blank">💬</a>

<div class="mnav">
  <button class="on"><span class="ic">🏠</span>الرئيسية</button>
  <button onclick="document.getElementById('mainGrid').scrollIntoView({behavior:'smooth'})"><span class="ic">🛍️</span>المنتجات</button>
  <button onclick="openCart()"><span class="ic">🛒</span>السلة</button>
</div>

<footer>
  <div class="logo"><span style="color:var(--forest);font-family:Lalezar">Earn<span style="color:var(--ink)">ify</span></span></div>
  <div>شحن لكل محافظات مصر • الدفع عند الاستلام • دعم عبر واتساب</div>
</footer>

<div class="modal" id="pm"><div class="sheet">
  <button class="sheet-x" onclick="closeM('pm')">✕</button>
  <div style="clear:both"></div>
  <img class="pm-img" id="pmImg">
  <div class="pm-name" id="pmName"></div>
  <div class="pm-price" id="pmPrice"></div>
  <div class="pm-desc" id="pmDesc"></div>
  <div class="qtyrow"><button onclick="chQ(-1)">−</button><b id="qV">1</b><button onclick="chQ(1)">+</button></div>
  <button class="addbtn" id="addBtn" onclick="addToCart()">أضف إلى السلة</button>
</div></div>

<div class="modal" id="cm"><div class="sheet">
  <button class="sheet-x" onclick="closeM('cm')">✕</button>
  <div style="clear:both"></div>
  <h3 class="pm-name">السلة</h3>
  <div id="cItems"></div>
  <div class="tot"><span>الإجمالي</span><b id="cTot">0</b></div>
  <button class="addbtn" onclick="openCo()" id="checkoutBtn">إتمام الطلب ❯</button>
</div></div>

<div class="modal" id="co"><div class="sheet">
  <button class="sheet-x" onclick="closeM('co')">✕</button>
  <div style="clear:both"></div>
  <h3 class="pm-name">بيانات التوصيل</h3>
  <label>الاسم بالكامل</label><input class="field" id="fName">
  <label>رقم الموبايل</label><input class="field" id="fPhone" type="tel">
  <label>العنوان بالتفصيل</label><textarea class="field" id="fAddr" rows="2"></textarea>
  <label>المحافظة</label><select class="field" id="fGov" onchange="updShip()"></select>
  <div class="tot"><span>الشحن + المنتجات</span><b id="coTot">0</b></div>
  <button class="addbtn" onclick="submitOrder()">تأكيد الطلب</button>
  <div class="msg" id="coMsg"></div>
</div></div>

<script>
var P=[],cart=[],cur=null,qty=1,GOVS=[],curCat='الكل',curQ='';

function fmt(n){return Number(n||0).toLocaleString('ar-EG')+' ج.م'}

function loadProducts(){
  if(window.__PRODUCTS && window.__PRODUCTS.length){ P=window.__PRODUCTS; afterLoad(); }
  fetch('/api/products').then(r=>r.json()).then(function(d){
    if(d && d.length){ P=d; afterLoad(); }
  }).catch(function(){ if(!P.length) afterLoad(); });
}
function afterLoad(){ renderCats(); renderGrid(); }

function getCats(){var s={};P.forEach(function(p){s[p.category||p.cat||'عام']=1});return ['الكل'].concat(Object.keys(s));}
function renderCats(){
  document.getElementById('catRow').innerHTML = getCats().map(function(c){
    return '<button class="cc'+(c===curCat?' on':'')+'" onclick="setCat(\''+c+'\')">'+c+'</button>';
  }).join('');
}
function setCat(c){curCat=c;renderCats();renderGrid();}
function doSearch(v){curQ=(v||'').trim();renderGrid();}

function visible(){
  return P.filter(function(p){
    if(curCat!=='الكل' && (p.category||p.cat||'عام')!==curCat) return false;
    if(curQ && (p.name||'').indexOf(curQ)===-1) return false;
    return true;
  });
}
function stockLabel(p){
  var s=p.stock;
  if(p.available===false || s===0) return '<span class="stock stock-out">نفذ من المخزون</span>';
  if(s && s<10) return '<span class="stock stock-low">كمية محدودة</span>';
  return '<span class="stock stock-ok">متوفر</span>';
}
function renderGrid(){
  var e=document.getElementById('mainGrid');
  var v=visible();
  var idx={}; P.forEach(function(p,i){idx[p.id]=i;});
  document.getElementById('prodTitle').textContent=(curCat!=='الكل'?curCat:(curQ?'نتائج البحث':'كل المنتجات'))+' ('+v.length+')';
  e.innerHTML = v.map(function(p){
    var i=idx[p.id];
    return '<div class="card" onclick="openP('+i+')"><div class="imgwrap"><img src="'+(p.image||'')+'" loading="lazy"><span class="cod">دفع عند الاستلام</span></div><div class="b"><div class="t">'+p.name+'</div><div class="pr">'+fmt(p.price)+'</div>'+stockLabel(p)+'</div></div>';
  }).join('') || '<div class="empty">لا توجد منتجات مطابقة 🔍</div>';
}

function openP(i){cur=P[i];qty=1;
  document.getElementById('pmImg').src=cur.image||'';
  document.getElementById('pmName').textContent=cur.name;
  document.getElementById('pmPrice').textContent=fmt(cur.price);
  document.getElementById('pmDesc').textContent=(cur.desc||'').replace(/<[^>]*>/g,' ');
  document.getElementById('qV').textContent=1;
  var out = cur.available===false || cur.stock===0;
  document.getElementById('addBtn').disabled=out;
  document.getElementById('addBtn').textContent = out ? 'غير متاح حالياً' : 'أضف إلى السلة';
  openM('pm');
}
function chQ(d){qty=Math.max(1,qty+d);document.getElementById('qV').textContent=qty;}
function addToCart(){
  if(!cur) return;
  var ex=cart.find(function(c){return c.id===cur.id});
  if(ex) ex.qty+=qty; else cart.push({id:cur.id,propId:cur.propId||'',name:cur.name,price:cur.price,image:cur.image,qty:qty});
  updCC(); closeM('pm'); openCart();
}
function updCC(){document.getElementById('cc').textContent=cart.reduce(function(a,c){return a+c.qty},0);}
function openCart(){
  var box=document.getElementById('cItems');
  box.innerHTML = cart.length ? cart.map(function(c,i){
    return '<div class="ci"><img src="'+(c.image||'')+'"><div class="n">'+c.name+'<br><small>'+c.qty+' × '+fmt(c.price)+'</small></div><div class="p">'+fmt(c.price*c.qty)+'</div><button class="rm" onclick="rmC('+i+')">حذف</button></div>';
  }).join('') : '<div class="cart-empty">سلتك فارغة 🛒</div>';
  document.getElementById('cTot').textContent=fmt(cart.reduce(function(a,c){return a+c.price*c.qty},0));
  document.getElementById('checkoutBtn').style.display = cart.length ? '' : 'none';
  openM('cm');
}
function rmC(i){cart.splice(i,1);updCC();openCart();}

var shipCost=0;
function loadGovs(){
  fetch('/api/price-list').then(function(r){return r.json()}).then(function(g){
    GOVS=g||[];
    document.getElementById('fGov').innerHTML = GOVS.map(function(x){return '<option value="'+x._id+'">'+x.name+'</option>'}).join('');
    updShip();
  }).catch(function(){});
}
function updShip(){
  var sel=document.getElementById('fGov').value;
  var g=GOVS.find(function(x){return x._id===sel});
  shipCost = g ? Number(g.price||0) : 0;
  document.getElementById('coTot').textContent=fmt(cart.reduce(function(a,c){return a+c.price*c.qty},0)+shipCost);
}
function openCo(){
  if(!cart.length) return;
  closeM('cm');
  if(!GOVS.length) loadGovs(); else updShip();
  openM('co');
}
function submitOrder(){
  var m=document.getElementById('coMsg'); m.className='msg';
  var name=document.getElementById('fName').value.trim();
  var phone=document.getElementById('fPhone').value.trim();
  var addr=document.getElementById('fAddr').value.trim();
  var gov=document.getElementById('fGov').value;
  if(!name||!phone||!addr||!gov){m.textContent='⚠️ اكمل بياناتك';m.className='msg err';return;}
  var items=cart.map(function(c){return {product:c.id,property:c.propId,qty:c.qty}});
  var total=cart.reduce(function(a,c){return a+c.price*c.qty},0)+shipCost;
  fetch('/api/create-order',{method:'POST',headers:{'Content-Type':'application/json','x-auth-token':localStorage.getItem('etok')||''},
    body:JSON.stringify({client_name:name,client_phone1:phone,client_address:addr,shipping_governorate:gov,items:items,total:total,shipping_cost:shipCost})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.error){m.textContent='⚠️ '+d.error;m.className='msg err';}
    else{m.textContent='✅ تم استلام طلبك بنجاح';m.className='msg ok';cart=[];updCC();setTimeout(function(){closeM('co');},1400);}
  }).catch(function(){m.textContent='⚠️ حصل خطأ، جرب تاني';m.className='msg err';});
}

function setupWA(){
  var a=document.getElementById('waFloat');
  a.href='https://wa.me/201000000000?text='+encodeURIComponent('مرحباً 👋 أريد الاستفسار عن المنتجات');
}
function openM(id){document.getElementById(id).classList.add('on')}
function closeM(id){document.getElementById(id).classList.remove('on')}

loadProducts(); setupWA();
</script>
</body>
</html>
