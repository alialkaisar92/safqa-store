# Rab7na Store environment variables
PORT=3000
PUBLIC_SITE_URL=https://rab7na-store.vercel.app
# بريد حساب المدير المسموح له بلوحة الإدارة
ADMIN_EMAIL=
# معرف مستخدم المدير البديل في Firestore
ADMIN_USER_ID=
SAFKA_API_KEY=
SAFKA_SYNC_SECRET=
# املأه فقط بعد تأكيد مسار الحالة من توثيق Safka، مثل https://api.safka-eg.com/.../{id}
SAFKA_ORDER_STATUS_URL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CLIENT_ID=
# Resend Email API. لا تضع المفتاح الحقيقي في GitHub.
EMAIL_API_KEY=
# عنوان مرسل موثّق في Resend مثل Rab7na <no-reply@your-domain.com>
EMAIL_FROM=
# مفتاح عشوائي طويل، مطلوب لتوقيع جلسات JWT.
JWT_SECRET=
