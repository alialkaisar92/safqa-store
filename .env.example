# Rab7na Store environment variables
PORT=3000
PUBLIC_SITE_URL=https://rab7na-store.vercel.app

# PostgreSQL managed connection (Neon Free or another compatible provider)
# Keep the real URL only in local .env / Vercel Environment Variables, never in GitHub.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=5

# Product source integration
SAFKA_API_KEY=
SAFKA_SYNC_SECRET=
SAFKA_ORDER_STATUS_URL=

# Optional support and application settings
WHATSAPP_SUPPORT_NUMBER=
EASYORDERS_SECRET=

# AI provider (server-side only; leave provider auto to prefer built-in Forge, then AI Gateway)
AI_PROVIDER=auto
AI_MODEL=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
# Optional alternatives: AI_BASE_URL + AI_API_KEY, OPENAI_API_BASE + OPENAI_API_KEY, or OLLAMA_BASE_URL
