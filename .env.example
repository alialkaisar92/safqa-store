# Rab7na Store environment variables
PORT=3000
PUBLIC_SITE_URL=https://rab7na-store.vercel.app
# بريد حساب المدير المسموح له بلوحة الإدارة
ADMIN_EMAIL=
# معرف مستخدم المدير البديل في Firestore
ADMIN_USER_ID=
SAFKA_API_KEY=
SAFKA_SYNC_SECRET=
# املأه فقط بعد تأكيد مسار الحالة من توثيق Safka، مثل https://api.safka-eg.com/.../{id}
SAFKA_ORDER_STATUS_URL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CLIENT_ID=
# SMTP هو المسار المفضل لإرسال OTP. لا تضع هذه القيم في GitHub.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Rab7na <no-reply@your-domain.example>
# Resend احتياطي اختياري إذا لم تضبط SMTP، ويحتاج نطاق إرسال موثق.
RESEND_API_KEY=
RESEND_FROM=Rab7na <onboarding@example.com>
JWT_SECRET=
