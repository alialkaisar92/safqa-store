# Rab7na Store environment variables
PORT=3000
PUBLIC_SITE_URL=https://rab7na-store.vercel.app

# PostgreSQL managed connection (Neon Free or another compatible provider)
# Keep the real URL only in local .env / Vercel Environment Variables, never in GitHub.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=5

# Product source integration
SAFKA_API_KEY=
SAFKA_SYNC_SECRET=
# Optional status lookup URL only if Safka provides a documented endpoint.
SAFKA_ORDER_STATUS_URL=
# Secret path token chosen by this app and appended to the configured Safka orderHook URL.
# Keep empty until Safka is configured with orderHook=https://<production>/api/webhooks/safka/order-status?token=<same-token>.
SAFKA_ORDER_HOOK_TOKEN=

# Optional support and application settings
WHATSAPP_SUPPORT_NUMBER=
EASYORDERS_SECRET=

# AI provider (server-side only; leave provider auto to prefer built-in Forge, then AI Gateway)
AI_PROVIDER=auto
AI_MODEL=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
# On Vercel, the server also accepts the platform-provided VERCEL_OIDC_TOKEN.
# Optional alternatives: AI_BASE_URL + AI_API_KEY, OPENAI_API_BASE + OPENAI_API_KEY, or OLLAMA_BASE_URL
