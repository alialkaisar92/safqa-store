# Rab7na Store environment variables
PORT=3000
PUBLIC_SITE_URL=https://rab7na-store.vercel.app

# PostgreSQL managed connection (Neon Free or another compatible provider)
# Keep the real URL only in local .env / Vercel Environment Variables, never in GitHub.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=5

# Product source integration
SAFKA_API_KEY=
SAFKA_SYNC_SECRET=
SAFKA_ORDER_STATUS_URL=

# Optional support and application settings
WHATSAPP_SUPPORT_NUMBER=
EASYORDERS_SECRET=
