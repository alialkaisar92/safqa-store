window.THEME={id:'premium',name:'Premium',gridClass:'products-grid',titleClass:'section-title',wrapClass:'container section',hideToolbar:true,cssUrl:'/themes/premium.css',
header:()=>`<header class="store-header"><div class="container header-inner"><div class="logo">🛍️ <span>${STORE.name||'Rab7na'}</span></div><nav class="main-nav"><a class="active">الرئيسية</a><a onclick="document.querySelector('.products-grid').scrollIntoView({behavior:'smooth'})">المنتجات</a></nav><div class="search-box"><input placeholder="ابحث عن منتج..." oninput="doSearch(this.value)"></div><button class="icon-btn cartb" onclick="openCart()">🛒<i id="cc">0</i></button></div></header>`,
hero:()=>`<div class="container"><div class="hero fade-up"><div class="hero-content"><h1>${STORE.hero||'تسوّق أحدث المنتجات بأفضل الأسعار'}</h1><p>${STORE.sub||'شحن سريع • الدفع عند الاستلام • إرجاع مجاني'}</p><button class="btn btn-primary" onclick="document.querySelector('.products-grid').scrollIntoView({behavior:'smooth'})">تسوّق الآن ❯</button></div></div></div>`,
categories:()=>`<div class="container"><div class="categories">${getCats().slice(1).map(function(c){return '<div class="category" onclick="setCat(\''+c+'\')"><span style="font-size:26px">🛍️</span><span>'+c+'</span></div>'}).join('')}</div></div>`,
card:(p,i)=>{var old=Math.round(p.price*1.25),off=Math.round(100-(p.price/old*100));return `<div class="product-card fade-up"><span class="product-badge">-${off}%</span><button class="favorite-btn">♡</button><div class="product-image"><img src="${p.image||''}" loading="lazy" onclick="openP(${i})"></div><div class="product-info"><div class="product-title">${p.name}</div><div class="product-rating">★★★★★</div><div class="product-price"><span class="price">${fmt(p.price)}</span><span class="old-price">${fmt(old)}</span></div><div class="product-actions"><button class="add-cart" onclick="openP(${i})">🛒 أضف للسلة</button><button class="quick-view" onclick="openP(${i})">👁</button></div></div></div>`},
sections:['hero','categories','featured','banner','products'],
banner:()=>`<div class="container"><div class="promo-banner"><h2>🔥 عروض حصرية لفترة محدودة</h2><p>خصومات تصل حتى 40% على منتجات مختارة — لا تفوّت الفرصة</p></div></div>`,
footer:()=>`<footer class="store-footer"><div class="container footer-grid"><div><h3>🛍️ ${STORE.name||'Rab7na'}</h3><p>${STORE.sub||'متجر إلكتروني موثوق'}</p></div><div><h3>روابط</h3><a>الرئيسية</a><a>المنتجات</a><a>العروض</a></div><div><h3>الدعم</h3><a>تواصل معنا</a><a>سياسة الإرجاع</a></div><div><h3>الدفع</h3><p>💵 الدفع عند الاستلام</p></div></div></footer>`,
mobileNav:()=>`<nav class="mobile-bottom-nav"><a class="active"><span class="icon">🏠</span>الرئيسية</a><a><span class="icon">🛍️</span>المنتجات</a><a onclick="openCart()"><span class="icon">🛒</span>السلة</a></nav>`};


// ===== زر واتساب العائم =====
(function(){
  if (document.querySelector('.wa-float')) return;
  var btn = document.createElement('a');
  btn.href = 'https://wa.me/201092876053?text=' + encodeURIComponent('مرحباً، عايز استفسر عن...');
  btn.target = '_blank';
  btn.rel = 'noopener';
  btn.className = 'wa-float';
  btn.setAttribute('aria-label', 'تواصل واتساب');
  btn.innerHTML = '<style>.wa-float{position:fixed!important;bottom:24px!important;left:24px!important;z-index:99999!important;width:60px!important;height:60px!important;border-radius:50%!important;background:linear-gradient(135deg,#25D366,#128C7E)!important;color:white!important;display:flex!important;align-items:center!important;justify-content:center!important;box-shadow:0 8px 24px rgba(37,211,102,.4)!important;cursor:pointer!important;text-decoration:none!important;transition:all .3s!important;animation:wa-pulse 2s infinite!important}.wa-float:hover{transform:scale(1.1)!important;box-shadow:0 12px 32px rgba(37,211,102,.6)!important}.wa-float::before{content:""!important;position:absolute!important;top:-8px!important;right:-8px!important;width:20px!important;height:20px!important;background:#ef4444!important;border-radius:50%!important;border:3px solid white!important;animation:wa-dot 1.5s infinite!important}@keyframes wa-pulse{0%,100%{box-shadow:0 8px 24px rgba(37,211,102,.4)!important}50%{box-shadow:0 8px 32px rgba(37,211,102,.7)!important}}@keyframes wa-dot{0%,100%{transform:scale(1)!important;opacity:1!important}50%{transform:scale(1.2)!important;opacity:.7!important}}@media(max-width:640px){.wa-float{bottom:90px!important;left:16px!important;width:56px!important;height:56px!important}.wa-float svg{width:28px!important;height:28px!important}}</style><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:32px;height:32px"><path fill="white" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>';
  document.body.appendChild(btn);
})();
