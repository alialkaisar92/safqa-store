let BANNERS=[];
let currentSlide=0;
function renderBanners(){const zone=document.getElementById('bannerZone');if(!zone)return;if(!BANNERS.length){zone.innerHTML='';zone.style.display='none';return;}zone.style.display='block';zone.innerHTML='<div class="banner-slider"><div class="banner-track" id="bannerTrack">'+BANNERS.map((b,i)=>'<div class="banner-slide" style="background:'+(b.bg||'linear-gradient(135deg,#0F766E,#14B8A6)')+'"><div class="banner-content"><h2>'+(b.title||'')+'</h2><p>'+(b.sub||'')+'</p>'+(b.btn?'<button class="banner-btn" onclick="'+(b.action||'')+'">'+b.btn+'</button>':'')+'</div></div>').join('')+'</div><div class="banner-dots" id="bannerDots">'+BANNERS.map((b,i)=>'<div class="banner-dot'+(i===0?' active':'')+'" onclick="goToSlide('+i+')"></div>').join('')+'</div></div>';currentSlide=0;}
function goToSlide(n){if(!BANNERS.length)return;currentSlide=n;const track=document.getElementById('bannerTrack');if(track)track.style.transform='translateX('+(n*100)+'%)';document.querySelectorAll('.banner-dot').forEach((d,i)=>d.classList.toggle('active',i===n));}
setInterval(()=>{if(document.getElementById('p-store')&&document.getElementById('p-store').classList.contains('active')&&BANNERS.length>1){currentSlide=(currentSlide+1)%BANNERS.length;goToSlide(currentSlide);}},4000);

function openDrawer(){var d=document.getElementById('drawer'),s=document.getElementById('scrim');if(d)d.classList.add('open');if(s)s.classList.add('open');fillDrawer();}
function closeDrawer(){var d=document.getElementById('drawer'),s=document.getElementById('scrim');if(d)d.classList.remove('open');if(s)s.classList.remove('open');}
function fillDrawer(){fetch('/api/me').then(function(r){return r.json();}).then(function(r){if(!r)return;var nm=(r.profile&&(r.profile.name||r.profile.username))||r.name||null;var bal=r.balance!=null?Number(r.balance):null;var av=document.getElementById('drAv'),nmE=document.getElementById('drName'),bE=document.getElementById('drBal');if(nm&&nmE)nmE.textContent=nm;if(av)av.textContent=(nm||'م').charAt(0);if(bE&&bal!=null)bE.innerHTML=bal.toLocaleString('ar-EG')+' <small>ج.م</small>';}).catch(function(){});}

let NOTIF_SEEN=Number(localStorage.getItem('notifSeen')||0); window.__NOTIFS=[];
function openNotif(){var d=document.getElementById('notifDrawer'),s=document.getElementById('notifScrim');if(d)d.classList.add('open');if(s)s.classList.add('open');NOTIF_SEEN=Date.now();localStorage.setItem('notifSeen',NOTIF_SEEN);updateNotifDot(false);renderNotifs();}
function closeNotif(){var d=document.getElementById('notifDrawer'),s=document.getElementById('notifScrim');if(d)d.classList.remove('open');if(s)s.classList.remove('open');}
function fmtNotifTime(t){if(!t)return'';try{var d=new Date(t);return d.toLocaleString('ar-EG',{dateStyle:'short',timeStyle:'short'});}catch(e){return t;}}
function renderNotifs(){var el=document.getElementById('notifList');if(!el)return;var list=window.__NOTIFS||[];if(!list.length){el.innerHTML='<div class="nd-empty"><div class="ic">🔔</div>مفيش إشعارات دلوقتي</div>';return;}el.innerHTML=list.map(function(n,i){var isNew=Number(n.id)>NOTIF_SEEN;return '<div class="nd-item'+(isNew?' new':'')+'" style="animation-delay:'+(i*40)+'ms"><h4>'+eoEsc(n.title)+'</h4>'+(n.body?'<p>'+eoEsc(n.body)+'</p>':'')+'<time>'+fmtNotifTime(n.time)+'</time></div>';}).join('');}
function updateNotifDot(on){var d=document.getElementById('notifDot');if(d)d.classList.toggle('on',!!on);}
function notifBeep(){try{var ctx=new (window.AudioContext||window.webkitAudioContext)();var o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.type='sine';o.frequency.value=880;g.gain.setValueAtTime(0.0001,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.18,ctx.currentTime+0.02);g.gain.exponentialRampToValueAtTime(0.0001,ctx.currentTime+0.4);o.start();o.stop(ctx.currentTime+0.42);}catch(e){}}
async function pollNotifs(){try{var list=await(await fetch('/api/notifications')).json();list=list||[];var fresh=list.filter(function(n){return Number(n.id)>NOTIF_SEEN;});updateNotifDot(fresh.length>0);if(fresh.length>0){notifBeep();}window.__NOTIFS=list;var dr=document.getElementById('notifDrawer');if(dr&&dr.classList.contains('open'))renderNotifs();}catch(e){}}
setInterval(pollNotifs,20000); setTimeout(pollNotifs,1500);
</script>
<script src="/eo-fix.js?v=9">
// ===== Chat engine (واتساب) =====
var CHAT_POLL=null, CHAT_LAST=-1;
function chatEsc(s){return (s==null?'':String(s)).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function chatFmtTime(iso){try{var d=new Date(iso);return d.toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'});}catch(e){return '';}}
function openChat(){document.getElementById('chatScreen').classList.add('open');document.body.style.overflow='hidden';chatRender(true);if(!CHAT_POLL){CHAT_POLL=setInterval(function(){chatRender(false);},3000);}}
function closeChat(){document.getElementById('chatScreen').classList.remove('open');document.body.style.overflow='';if(CHAT_POLL){clearInterval(CHAT_POLL);CHAT_POLL=null;}}
async function chatRender(force){var body=document.getElementById('chatBody');if(!body)return;try{var msgs=await (await fetch('/api/chat/messages')).json();if(!Array.isArray(msgs))msgs=[];if(!force&&msgs.length===CHAT_LAST)return;var atBottom=body.scrollHeight-body.scrollTop-body.clientHeight<70;if(!msgs.length){body.innerHTML='<div class="chat-empty"><div class="ic">💬</div><p>ابدأ المحادثة — اكتب رسالة أو ابعت صورة أو سجّل صوت</p></div>';CHAT_LAST=0;return;}body.innerHTML=msgs.map(function(m){var content='';if(m.type==='image'){content='<img src="'+m.media+'" alt="صورة">';}else if(m.type==='video'){content='<video src="'+m.media+'" controls></video>';}else if(m.type==='voice'){content='<audio src="'+m.media+'" controls></audio>';}if(m.text){content+='<div class="msg-text">'+chatEsc(m.text)+'</div>';}var tick=m.from==='user'?' ✓✓':'';return '<div class="msg '+m.from+'"><div class="bubble">'+content+'<div class="msg-time">'+chatFmtTime(m.time)+tick+'</div></div></div>';}).join('');if(atBottom||force||msgs.length>CHAT_LAST){body.scrollTop=body.scrollHeight;}CHAT_LAST=msgs.length;}catch(e){console.error('[chat] render err',e);}}
async function chatSend(){var inp=document.getElementById('chatInput');var text=inp.value.trim();if(!text)return;var btn=document.getElementById('chatSendBtn');btn.disabled=true;inp.value='';try{await fetch('/api/chat/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'text',text:text})});await chatRender(true);}catch(e){alert('فشل الإرسال: '+e.message);}finally{btn.disabled=false;inp.focus();}}

// ===== Chat media (صور + فيديو + ڤويس) =====
var chatRecorder=null, chatChunks=[], chatRecording=false;
function chatOnFile(input){var file=input.files[0];if(!file)return;if(file.size>5*1024*1024){alert('الملف كبير — الحد الأقصى 5 ميجا');input.value='';return;}var type=file.type.startsWith('video')?'video':'image';var reader=new FileReader();reader.onload=function(e){fetch('/api/chat/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:type,media:e.target.result})}).then(function(){chatRender(true);}).catch(function(err){alert('فشل إرسال الملف: '+err.message);});};reader.readAsDataURL(file);input.value='';}
async function chatToggleVoice(){var mic=document.getElementById('chatMic');if(chatRecording){if(chatRecorder)chatRecorder.stop();return;}try{var stream=await navigator.mediaDevices.getUserMedia({audio:true});chatChunks=[];chatRecorder=new MediaRecorder(stream);chatRecorder.ondataavailable=function(e){if(e.data.size>0)chatChunks.push(e.data);};chatRecorder.onstop=function(){var blob=new Blob(chatChunks,{type:(chatRecorder.mimeType||'audio/webm')});stream.getTracks().forEach(function(tr){tr.stop();});var reader=new FileReader();reader.onload=function(ev){fetch('/api/chat/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'voice',media:ev.target.result})}).then(function(){chatRender(true);}).catch(function(err){alert('فشل إرسال الصوت: '+err.message);});};reader.readAsDataURL(blob);chatRecording=false;mic.classList.remove('rec');mic.textContent='🎤';};chatRecorder.start();chatRecording=true;mic.classList.add('rec');mic.textContent='⏹️';}catch(e){alert('تعذّر الوصول للميكروفون: '+e.message);}}

// Fallback: يضمن إن زرار "افتح المحادثة" يفتح الشات دائماً
document.addEventListener('click',function(e){var b=e.target&&e.target.closest?e.target.closest('#p-support .btn-primary'):null;if(b&&typeof openChat==='function'){openChat();}});
</script>

<script src="/notify.js?v=3"></script>
</body>
</html>`);
});


