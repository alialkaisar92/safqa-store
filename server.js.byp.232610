// ===== NO-CACHE: إجبار المتصفح يجيب أحدث نسخة دايماً =====
app.use(function(req,res,next){try{if(req.method==='GET'){var p=req.path||'';if(p==='/'||p===''||/\.(js|html|css|json)$/.test(p)||p.indexOf('/api/')===0){res.setHeader('Cache-Control','no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0');res.setHeader('Pragma','no-cache');res.setHeader('Expires','0');res.setHeader('Surrogate-Control','no-store');}}}catch(e){}next();});
