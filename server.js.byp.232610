// [EASYORDERS_INTEGRATION] — تكامل EasyOrders (معزول تماماً، لا يعطّل المتجر عند الفشل)
try {
  const { initDb } = require('./services/db');
  initDb();
  const authSvc = require('./services/auth.service');
  authSvc.ensureDefaultMarketer();
  const eoRoutes = require('./routes/easyorders.routes');
  app.use('/api/easyorders', eoRoutes);
  const cron = require('./cron/easyordersSync');
  const eoCtrl = require('./controllers/easyordersController');
  const eoOrders = require('./controllers/easyordersOrders');
  cron.start(eoCtrl.syncProducts, eoOrders.syncOrderStatuses);
  console.log('[EasyOrders] integration ready at /api/easyorders');
} catch (eoErr) {
  console.error('[EasyOrders] failed to initialize (store & admin still running):', eoErr.message);
}


// ===== Chat (واتساب) — additive، الدعم القديم يفضل شغال =====

function _chatUser(req){var tk='';try{var c=req.headers.cookie||'';var mm=c.match(/(?:^|;\s*)sq_t=([^;]+)/);if(mm)tk=decodeURIComponent(mm[1]);}catch(e){}if(!tk)tk=req.headers['x-sq-token']||'';if(!tk)return null;try{var svc=require('./services/auth.service');var u=svc.pubMe?svc.pubMe(tk):null;if(!u)return null;return {uid:'u'+u.id,name:u.display_name||u.username||('user'+u.id)};}catch(e){return null;}}
function _getUserChat(uid){if(!data.chats)data.chats={};if(!data.chats[uid])data.chats[uid]={messages:[],userName:uid};return data.chats[uid];}
app.get('/api/chat/messages',(req,res)=>{var cu=_chatUser(req);if(!cu)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({error:'login'});res.json(_getUserChat(cu.uid).messages);});
app.post('/api/chat/send',(req,res)=>{var cu=_chatUser(req);if(!cu)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({error:'login'});const b=req.body||{};const c=_getUserChat(cu.uid);c.userName=cu.name;const m={id:Date.now(),from:'user',userName:cu.name,type:b.type||'text',text:b.text||'',media:b.media||'',time:new Date().toISOString()};if(!m.text&&!m.media)return res.status(400).json({error:'فاضي'});c.messages.push(m);saveData();res.json({ok:true});});
app.get('/api/admin/chat/messages',_adminGuard2,(req,res)=>{var uid=req.query.userId;if(!data.chats)data.chats={};res.json((data.chats[uid]&&data.chats[uid].messages)||[]);});
app.post('/api/admin/chat/send',_adminGuard2,(req,res)=>{const b=req.body||{};var uid=b.userId;if(!uid)return res.status(400).json({error:'userId مطلوب'});if(!data.chats)data.chats={};if(!data.chats[uid])data.chats[uid]={messages:[],userName:uid};const m={id:Date.now(),from:'admin',type:b.type||'text',text:b.text||'',media:b.media||'',time:new Date().toISOString()};if(!m.text&&!m.media)return res.status(400).json({error:'فاضي'});data.chats[uid].messages.push(m);saveData();res.json({ok:true});});
app.get('/api/admin/chat/list',_adminGuard2,(req,res)=>{if(!data.chats)data.chats={};var list=Object.keys(data.chats).map(function(uid){var msgs=data.chats[uid].messages||[];var last=msgs.length?msgs[msgs.length-1]:null;var nm=data.chats[uid].userName||uid;return {uid:uid,name:nm,count:msgs.length,lastText:last?(last.text||('['+last.type+']')):'',lastTime:last?last.time:null};});list.sort(function(a,b){return String(b.lastTime||'').localeCompare(String(a.lastTime||''));});res.json(list);});




}

// ===== EasyOrders Integration =====
let eoApiKey = null;
try { eoApiKey = (data.eoApiKey) || null; } catch(e) {}

app.post('/api/easyorders/connect', checkAdmin, (req,res) => {
  const key = (req.body||{}).apiKey;
  if(!key) return res.status(400).json({ok:false,error:'API Key مطلوب'});
  fetch('https://api.easy-orders.net/api/v1/external-apps/products', {headers:{'Api-Key':key}})
    .then(r => { if(r.ok) { eoApiKey=key; data.eoApiKey=key; saveData(); res.json({ok:true}); } else console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({ok:false,error:'API Key غلط أو مش صالح'}); })
    .catch(e => res.status(500).json({ok:false,error:'تعذّر الاتصال بـ EasyOrders'}));
});

app.get('/api/easyorders/status', (req,res) => {
  res.json({connected: !!eoApiKey});
});

app.post('/api/easyorders/export', checkAdmin, (req,res) => {
  if(!eoApiKey) return res.status(400).json({ok:false,error:'اربط EasyOrders الأول من لوحة الأدمن'});
  const p = req.body||{};
  const product = {
    name: p.name || 'منتج',
    price: Number(p.price) || 0,
    sale_price: Number(p.sale_price) || Number(p.price) || 0,
    description: p.description || '',
    slug: (p.name||'product').replace(/[^a-zA-Z0-9\u0600-\u06FF]/g,'-').toLowerCase() + '-' + Date.now(),
    sku: p.id || ('sq-' + Date.now()),
    thumb: p.image || '',
    images: p.image ? [p.image] : [],
    quantity: Number(p.stock) || 100,
    track_stock: true
  };
  fetch('https://api.easy-orders.net/api/v1/external-apps/products', {
    method: 'POST',
    headers: {'Api-Key': eoApiKey, 'Content-Type': 'application/json'},
    body: JSON.stringify(product)
  })
    .then(r => r.json().then(j => { if(r.ok) res.json({ok:true,data:j}); else res.status(r.status).json({ok:false,error:j.message||'فشل التصدير'}); }))
    .catch(e => res.status(500).json({ok:false,error:'تعذّر الاتصال بـ EasyOrders'}));
});

// ===== Admin: Create User =====
app.post('/api/admin/users/create', checkAdmin, (req,res) => {
  try {
    const b = req.body||{};
    const u = _authSvc.pubRegister(b.username, b.password, b.display_name||b.username, b.phone||'', b.email||'');
    if(b.role && b.role !== 'customer') _authSvc.pubSetRole(u.user.id, b.role);
    res.json({ok:true, user: u.user});
  } catch(e) { res.status(400).json({ok:false, error: e.message}); }
});


try{if(data&&data.chat&&data.chat.messages&&data.chat.messages.length&&!data.chats){data.chats=data.chats||{};data.chats['legacy']={messages:data.chat.messages,userName:'محادثات قديمة'};saveData();}}catch(e){}

// ===== V2 Settings API (المرحلة 1) =====
const settings = require('./lib/settings');
app.get('/api/v2/settings', (req, res) => {
  res.json(settings.getAll());
});
app.put('/api/v2/settings', checkAdmin, (req, res) => {
  const b = req.body || {};
  settings.setMany(b);
  res.json({ ok: true, updated: Object.keys(b).length });
});

// ===== V2 Products API (المرحلة 3) =====
const db2 = require('./lib/database');
app.get('/api/v2/products', (req, res) => {
  try {
    const rows = db2.prepare('SELECT * FROM products ORDER BY id DESC').all();
    res.json(rows);
  } catch (e) { res.status(500).json({ error: e.message }); }
});
app.post('/api/v2/products', checkAdmin, (req, res) => {
  try {
    const b = req.body || {};
    const r = db2.prepare(`
      INSERT INTO products (name, description, category_id, image, price, base_price, commission, stock, active)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1)
    `).run(b.name||'', b.description||'', b.category_id||null, b.image||'', b.price||0, b.base_price||0, b.commission||0, b.stock||0);
    res.json({ ok: true, id: r.lastInsertRowid });
  } catch (e) { res.status(500).json({ error: e.message }); }
});
app.put('/api/v2/products/:id', checkAdmin, (req, res) => {
  try {
    const b = req.body || {};
    const id = req.params.id;
    db2.prepare(`
      UPDATE products SET name=?, description=?, category_id=?, image=?, price=?, base_price=?, commission=?, stock=?, active=?
      WHERE id=?
    `).run(b.name||'', b.description||'', b.category_id||null, b.image||'', b.price||0, b.base_price||0, b.commission||0, b.stock||0, b.active!==undefined?b.active:1, id);
    res.json({ ok: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});
app.delete('/api/v2/products/:id', checkAdmin, (req, res) => {
  try {
    db2.prepare('DELETE FROM products WHERE id=?').run(req.params.id);
    res.json({ ok: true });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// ===== Migration: نسخ المنتجات لـ SQLite (مع retry) =====
let _migrationDone = false;
const _migrationInterval = setInterval(async () => {
  if (_migrationDone) { clearInterval(_migrationInterval); return; }
  try {
    const db = require('./lib/database');
    const count = db.prepare('SELECT COUNT(*) as c FROM products').get().c;
    if (count > 0) {
      console.log('[migration] SQLite already has', count, 'products — skipping');
      _migrationDone = true;
      clearInterval(_migrationInterval);
      return;
    }
    const products = await getProducts();
    if (!Array.isArray(products) || products.length === 0) {
      console.log('[migration] Waiting for products...');
      return;
    }
    const stmt = db.prepare('INSERT OR IGNORE INTO products (id, name, description, category_id, image, price, base_price, commission, stock, sales_count, active) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)');
    db.exec('BEGIN');
    try {
      for (const p of products) {
        stmt.run(
          typeof p.id === 'number' ? p.id : null,
          p.name || '',
          p.description || p.desc || '',
          p.category_id || null,
          p.image || '',
          Number(p.price) || 0,
          Number(p.base_price) || Number(p.price) || 0,
          Number(p.commission) || 0,
          Number(p.stock) || 0,
          Number(p.sales_count) || 0
        );
      }
      db.exec('COMMIT');
    } catch (e) {
      db.exec('ROLLBACK');
      throw e;
    }
    console.log('[migration] ✅ Migrated', products.length, 'products to SQLite');
    _migrationDone = true;
    clearInterval(_migrationInterval);
  } catch (e) {
    console.log('[migration] ❌ Error:', e.message);
  }
}, 5000);

app.listen(PORT, () => {
  console.log('المتجر: http://localhost:' + PORT);
  getProducts();
  getPriceList();
});
