if(!data.users||!data.users.length){data.users=[{username:'admin',password:'admin123',role:'admin',permissions:['all'],createdAt:new Date().toISOString().slice(0,10)}];save();}
function authenticate(req){const cred=req.headers['x-admin-cred'];if(!cred)return null;try{const d=Buffer.from(cred,'base64').toString('utf-8');const i=d.indexOf(':');if(i===-1)return null;const u=d.slice(0,i),pw=d.slice(i+1);return (data.users||[]).find(x=>x.username===u&&x.password===pw)||null;}catch(e){return null;}}
function hasPerm(user,perm){if(!user)return false;if(user.role==='admin')return true;const pp=user.permissions||[];return pp.includes('all')||pp.includes(perm);}
const checkAdmin=(req,res,next)=>{try{var _ah=req.headers['authorization']||'';if(_ah.indexOf('Basic ')===0&&!(req.headers['x-sq-token']||req.headers['x-admin-token'])){var _tk='';global.__BC=global.__BC||{};var _n=Date.now();if(global.__BC[_ah]&&_n-global.__BC[_ah].t<300000){_tk=global.__BC[_ah].v;}else{try{var _raw=Buffer.from(_ah.slice(6),'base64').toString('utf8');var _ii=_raw.indexOf(':');if(_ii>0){var _sv=require('./services/auth.service');var _rr=_sv.pubLogin(_raw.slice(0,_ii),_raw.slice(_ii+1));if(_rr&&_rr.token){_tk=_rr.token;global.__BC[_ah]={v:_tk,t:_n};}}}catch(_e){}}if(_tk){req.headers['x-sq-token']=_tk;req.headers['x-admin-token']=_tk;req.headers['authorization']='Bearer '+_tk;}}}catch(_e){}try{console.log('[checkAdmin]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'x-sq=',!!req.headers['x-sq-token']);}catch(_e){}const user=authenticate(req);if(!user)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({error:'غير مصرح'});req.adminUser=user;next();};
app.post('/api/admin/login',(req,res)=>{const b=req.body||{};const user=(data.users||[]).find(u=>u.username===b.username&&u.password===b.password);if(!user)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({error:'بيانات الدخول غير صحيحة'});res.json({ok:true,user:{username:user.username,role:user.role,permissions:user.permissions||[]}});});
app.get('/api/admin/stats',checkAdmin,(req,res)=>{const o=data.orders||[];res.json({balance:data.balance||0,totalOrders:o.length,pendingOrders:o.filter(x=>x.status==='قيد التأكيد').length,deliveredOrders:o.filter(x=>x.status==='تم التسليم').length,totalCommission:o.reduce((s,x)=>s+(Number(x.commission)||0),0),pendingWithdrawals:(data.withdrawals||[]).filter(w=>w.status==='pending').length,newTickets:(data.tickets||[]).filter(x=>x.status==='جديد').length,totalUsers:(data.users||[]).length});});
