function _allTokens(req){
  var out=[];
  try{var c=req.headers.cookie||'';var ms=c.match(/(?:^|;\s*)(sq_t|admin_token|admin_session|sq_user_token)=([^;]+)/g);if(ms)ms.forEach(function(p){var v=p.split('=')[1];if(v)out.push(decodeURIComponent(v));});}catch(e){}
  ['x-sq-token','x-admin-token','x-marketer-token','authorization'].forEach(function(h){var v=req.headers[h];if(v){if(/^bearer\s+/i.test(v))v=v.replace(/^bearer\s+/i,'');if(v)out.push(v);}});
  if(req.query&&req.query.token)out.push(req.query.token);
  if(req.body&&req.body.token)out.push(req.body.token);
  return out.filter(function(x,i,a){return x&&a.indexOf(x)===i;});
}
function _adminOk2(req){
  try{var svc=require('./services/auth.service');var tks=_allTokens(req);for(var i=0;i<tks.length;i++){try{var u=svc.pubMe?svc.pubMe(tks[i]):null;if(u&&(u.role==='admin'))return u;}catch(e){}}}catch(e){}
  // fallback: نظام أدمن قديم محتمل (باسورد/توكن ثابت في data)
  try{var b=req.body||{};if(data&&data.adminPassword&&(b.password===data.adminPassword||b.adminPassword===data.adminPassword))return {role:'admin',username:'admin',display_name:'مدير'};}catch(e){}
  try{if(data&&data.adminToken){var tks2=_allTokens(req);if(tks2.indexOf(data.adminToken)>=0)return {role:'admin',username:'admin',display_name:'مدير'};}}catch(e){}
  return null;
}
function _adminGuard2(req,res,next){var u=_adminOk2(req);if(!u)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({ok:false,error:'صلاحيات الأدمن مطلوبة'});req.adminUser=u;next();}

function _notifCutoff(req){try{var svc=require('./services/auth.service');var tk='';try{var c=req.headers.cookie||'';var mm=c.match(/(?:^|;\s*)sq_t=([^;]+)/);if(mm)tk=decodeURIComponent(mm[1]);}catch(e){}if(!tk)tk=req.headers['x-sq-token']||'';if(!tk)return 0;var u=svc.pubMe?svc.pubMe(tk):null;if(!u||!u.created_at)return 0;var ms=new Date(u.created_at).getTime();return isNaN(ms)?0:ms;}catch(e){return 0;}}
function _filterNotifs(req,list){var cut=_notifCutoff(req);if(!cut)return list||[];return (list||[]).filter(function(n){var ct=Number(n.createdAt)||Number(n.id)||0;return ct>=cut;});}

// ===== GATE: حماية المحتوى لغير المسجّلين =====
function _gateToken(req){try{var c=req.headers.cookie||'';var m=c.match(/(?:^|;\s*)sq_t=([^;]+)/);if(m)return decodeURIComponent(m[1]);}catch(e){}var h=req.headers['x-sq-token']||'';if(h)return h;if(req.headers.authorization)return req.headers.authorization.replace(/^Bearer\s+/i,'');return (req.query&&req.query.token)||'';}
const _GATED=['/api/products','/api/banners','/api/chat/messages','/api/notifications','/api/updates','/api/stream'];

// ===== Basic-Auth Bridge: يحوّل Basic auth -> token (يحل 401 للأدمن) =====
var _BASIC_CACHE={};
app.use(function(req,res,next){
  try{
    var h=req.headers['authorization']||'';
    if(h.indexOf('Basic ')===0){
      var tk=(req.headers['x-sq-token']||'')||(req.headers['x-admin-token']||'')||(((req.headers.cookie||'').match(/(?:^|;\s*)sq_t=([^;]+)/)||[])[1])||(((req.headers.cookie||'').match(/(?:^|;\s*)admin_token=([^;]+)/)||[])[1]);
      if(!tk){
        var now=Date.now(); var c=_BASIC_CACHE[h];
        if(c && (now-c.t)<300000){ tk=c.token; }
        else{
          var raw=Buffer.from(h.slice(6),'base64').toString('utf8'); var i=raw.indexOf(':');
          if(i>0){ try{ var svc=require('./services/auth.service'); var r=svc.pubLogin(raw.slice(0,i),raw.slice(i+1)); if(r&&r.token){tk=r.token; _BASIC_CACHE[h]={token:tk,t:now};} }catch(e){} }
        }
        if(tk){ req.headers['x-sq-token']=tk; req.headers['x-admin-token']=tk; }
      }
    }
  }catch(e){}
  next();
});
app.use(function(req,res,next){if(_GATED.indexOf(req.path)>=0){var tk=_gateToken(req);if(!tk)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({ok:false,error:'login required'});try{var svc=require('./services/auth.service');var u=svc.pubMe?svc.pubMe(tk):null;if(!u)return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({ok:false,error:'login required'});}catch(e){return console.log('[401]',req.method,req.path,'basic=',(req.headers.authorization||'').indexOf('Basic ')===0,'xsq=',!!(req.headers['x-sq-token']||req.headers['x-admin-token']),'cook=',!!((req.headers.cookie||'').match(/sq_t=|admin_token=/)));res.status(401).json({ok:false,error:'login required'});}}next();});

